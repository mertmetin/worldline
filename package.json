{
  "name": "worldline",
  "version": "0.1.0",
  "description": "An AI game master with a persistent world graph and branching timelines.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "d3-force": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
